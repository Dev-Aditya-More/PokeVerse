<?xml version="1.0" encoding="utf-8"?>
<!-- Streak widget card, "urgent" mood: base gradient + a glow behind Pikachu + a soft rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient android:angle="315" android:type="linear"
                android:startColor="#FF1A0A0E" android:centerColor="#FF2A0D12" android:endColor="#FF3A0F0F" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient android:type="radial" android:centerX="0.3" android:centerY="0.42"
                android:gradientRadius="170dp" android:startColor="#66FF4D4D" android:endColor="#00000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <stroke android:width="1dp" android:color="#55FF6B6B" />
        </shape>
    </item>
</layer-list>
