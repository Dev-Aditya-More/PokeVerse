<?xml version="1.0" encoding="utf-8"?>
<!-- Streak widget card, "sleep" mood: base gradient + a glow behind Pikachu + a soft rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient android:angle="315" android:type="linear"
                android:startColor="#FF070B18" android:centerColor="#FF0C1328" android:endColor="#FF141A33" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient android:type="radial" android:centerX="0.3" android:centerY="0.42"
                android:gradientRadius="170dp" android:startColor="#407DB9FF" android:endColor="#00000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <stroke android:width="1dp" android:color="#337DB9FF" />
        </shape>
    </item>
</layer-list>
