<?xml version="1.0" encoding="utf-8"?>
<!-- Coin-shop widget look "ember": a double accent rim drawn over the mood card (same 26dp corners as the Pro rim). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <stroke android:width="2dp" android:color="#FFFF7043" />
        </shape>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#59FFAB91" />
        </shape>
    </item>
</layer-list>
