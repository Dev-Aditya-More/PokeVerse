<?xml version="1.0" encoding="utf-8"?>
<!-- Intentionally invisible: the OS splash shows only the night-sky background, so the first thing
     anyone sees is the Compose splash's own ball charging up, not a second logo. (The path is
     required: a vector with no path fails to inflate on some Android versions.) -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:pathData="M0,0h24v24h-24z" />
</vector>
