<?xml version="1.0" encoding="utf-8"?>
<!-- Streak widget card, "safe" mood: base gradient + a glow behind Pikachu + a soft rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient android:angle="315" android:type="linear"
                android:startColor="#FF101A14" android:centerColor="#FF14241A" android:endColor="#FF2E2208" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient android:type="radial" android:centerX="0.3" android:centerY="0.42"
                android:gradientRadius="170dp" android:startColor="#55FFC24B" android:endColor="#00000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <stroke android:width="1dp" android:color="#40FFD54F" />
        </shape>
    </item>
</layer-list>
