<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup/transfer. An ALLOWLIST: only the player's own progress and settings travel.

    Deliberately left out (everything not included below):
    - Firebase Auth (shared_prefs com.google.firebase.auth.*): its encryption key lives in the
      device Keystore, which is never restored. A restored copy can't be decrypted, so the user
      came back "signed in" in user_profile but signed out in Firebase: no leaderboard, no
      sign-out button until data was cleared.
    - Firestore's local cache, FCM / Installations IDs, Analytics, Crashlytics, AdMob, WebView:
      device identities and caches that must be fresh per install.
    - billing_prefs and RevenueCat prefs: premium is re-verified with Play on launch.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/user_profile.preferences_pb" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="datastore/theme_preferences.preferences_pb" />
        <include domain="file" path="datastore/pokedex_progress.preferences_pb" />
        <include domain="file" path="datastore/dex_daily.preferences_pb" />
        <include domain="database" path="pokeverseTeam_db" />
        <include domain="database" path="pokeverseTeam_db-wal" />
        <include domain="database" path="pokeverseTeam_db-shm" />
        <include domain="sharedpref" path="dex_mode.xml" />
        <include domain="sharedpref" path="app_locale_prefs.xml" />
        <include domain="sharedpref" path="daily_fact.xml" />
        <include domain="sharedpref" path="clash_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/user_profile.preferences_pb" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="datastore/theme_preferences.preferences_pb" />
        <include domain="file" path="datastore/pokedex_progress.preferences_pb" />
        <include domain="file" path="datastore/dex_daily.preferences_pb" />
        <include domain="database" path="pokeverseTeam_db" />
        <include domain="database" path="pokeverseTeam_db-wal" />
        <include domain="database" path="pokeverseTeam_db-shm" />
        <include domain="sharedpref" path="dex_mode.xml" />
        <include domain="sharedpref" path="app_locale_prefs.xml" />
        <include domain="sharedpref" path="daily_fact.xml" />
        <include domain="sharedpref" path="clash_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
